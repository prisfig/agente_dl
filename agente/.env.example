# Copia este archivo como .env (en la misma carpeta) y pon valores propios.
# .env NUNCA se sube al repositorio ni se comparte. React no lee este archivo.
# Genera claves con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Clave que la interfaz debe enviar al backend (encabezado X-API-Key).
BACKEND_API_KEY=

# Clave que el backend envía al gateway de Ollama (encabezado X-API-Key).
GATEWAY_API_KEY=

# Dirección local de Ollama (solo la usa el gateway).
OLLAMA_URL=http://127.0.0.1:11434

# v2.0 · Avisos por correo (opcional; sin estos valores el laboratorio funciona igual, sin avisos).
# Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (16 letras). No uses tu contraseña normal.
CORREO_USUARIO=
CORREO_CONTRASENA_APP=
# Quién recibe los avisos (si lo dejas vacío, se envían a CORREO_USUARIO).
CORREO_DESTINO=

# Alternativa (deshabilitada en config/agente.json): avisos por WhatsApp.
# Proveedor "meta" (config/agente.json → notificaciones.whatsapp.proveedor): WhatsApp Cloud API oficial.
#   En developers.facebook.com → tu app → WhatsApp → Configuración de la API: copia el token de acceso y el
#   identificador del número de teléfono de prueba, y agrega tu número a la lista de destinatarios.
#   El token temporal caduca a las 24 h: genera otro cuando caduque.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Tu número tal como aparece en la lista de destinatarios de Meta (con código de país, sin espacios).
WHATSAPP_DESTINO=
# Proveedor "callmebot" (alternativa): https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_TELEFONO=
CALLMEBOT_APIKEY=
