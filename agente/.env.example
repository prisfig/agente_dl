# Copia este archivo como .env (en la misma carpeta) y pon valores propios.
# .env NUNCA se sube al repositorio ni se comparte. React no lee este archivo.
# Genera claves con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Clave que la interfaz debe enviar al backend (encabezado X-API-Key).
BACKEND_API_KEY=

# Clave que el backend envía al gateway de Ollama (encabezado X-API-Key).
GATEWAY_API_KEY=

# Dirección local de Ollama (solo la usa el gateway).
OLLAMA_URL=http://127.0.0.1:11434
